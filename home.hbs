{{!< default}}

{{!-- Hero --}}
{{> hero }}

{{!-- MOnalytics: Performance & Method sections --}}
<section class="container wrapper section mo-performance">
  <div class="mo-performance__head">
    <span class="mo-performance__label">{{t "Verified Track Record"}}</span>
    <h2 class="section__title">{{t "80% Hit Rate."}}<br>{{t "Not a claim — a fact."}}</h2>
    <p class="mo-performance__text">{{t "Only analyses where the target zone was clearly reached or clearly missed are counted. Deleted or adjusted analyses don't improve the score."}}</p>
    <p class="mo-performance__text">{{t "No cherry-picking. No retroactive changes. Every outcome is publicly logged."}}</p>
  </div>

  <div class="mo-performance__grid">
    <div class="mo-stat">
      <span class="mo-stat__num mo-stat__num--accent">80%</span>
      <span class="mo-stat__label">{{t "Hit Rate"}}</span>
    </div>
    <div class="mo-stat">
      <span class="mo-stat__num mo-stat__num--hit">8</span>
      <span class="mo-stat__label">{{t "Confirmed Hits"}}</span>
    </div>
    <div class="mo-stat">
      <span class="mo-stat__num mo-stat__num--miss">2</span>
      <span class="mo-stat__label">{{t "Confirmed Misses"}}</span>
    </div>
    <div class="mo-stat">
      <span class="mo-stat__num">52+</span>
      <span class="mo-stat__label">{{t "Total Analyses"}}</span>
    </div>
  </div>

  <a href="/performance-tracker-card/" class="mo-btn">{{t "See Full Tracker"}} →</a>
</section>

<section class="container wrapper section mo-method">
  <span class="mo-performance__label">{{t "The Method"}}</span>
  <h2 class="section__title">{{t "How We Find the Next Move"}}</h2>
  <p class="mo-performance__text">{{t "We identify wave structures in price action to forecast high-probability turning points — before they happen."}}</p>

  <div class="mo-steps">
    <div class="mo-step">
      <span class="mo-step__num">01</span>
      <h3 class="mo-step__title">{{t "Map the Wave Structure"}}</h3>
      <p class="mo-step__desc">{{t "We chart the current Elliott Wave position across multiple timeframes — impulse waves, corrective sequences, and nested sub-waves."}}</p>
    </div>
    <div class="mo-step">
      <span class="mo-step__num">02</span>
      <h3 class="mo-step__title">{{t "Define Fibonacci Zones"}}</h3>
      <p class="mo-step__desc">{{t "Retracement and extension levels pinpoint precise entry zones, price targets, and invalidation levels. No guessing."}}</p>
    </div>
    <div class="mo-step">
      <span class="mo-step__num">03</span>
      <h3 class="mo-step__title">{{t "Publish & Track Publicly"}}</h3>
      <p class="mo-step__desc">{{t "Every analysis is logged and tracked publicly. Every outcome — hit or miss — counts. No cherry-picking, no retroactive edits."}}</p>
    </div>
  </div>
</section>

<style>
.mo-performance__label{display:block;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--color-primary);margin-bottom:12px;}
.mo-performance__text{max-width:560px;color:var(--color-grey-light);font-size:15px;line-height:1.7;margin-top:12px;}
.mo-performance__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:32px 0;}
.mo-stat{background:var(--color-dark-acc);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:24px 16px;text-align:center;}
.mo-stat__num{display:block;font-size:36px;font-weight:800;color:var(--color-white);line-height:1;}
.mo-stat__num--accent{color:var(--color-primary);}
.mo-stat__num--hit{color:var(--color-success);}
.mo-stat__num--miss{color:var(--color-error);}
.mo-stat__label{display:block;margin-top:8px;font-size:11px;letter-spacing:0.5px;text-transform:uppercase;color:var(--color-grey-light);}
.mo-btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:6px;background:var(--color-primary);color:var(--color-black);font-weight:700;font-size:14px;text-decoration:none;transition:opacity .2s, transform .2s;}
.mo-btn:hover{opacity:.9;transform:translateY(-1px);}
.mo-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:32px;}
.mo-step__num{display:block;font-size:44px;font-weight:900;color:rgba(255,255,255,0.14);line-height:1;font-family:monospace;}
.mo-step__title{margin:16px 0 10px;font-size:18px;font-weight:600;color:var(--color-white);}
.mo-step__desc{font-size:14px;line-height:1.7;color:var(--color-grey-light);}
@media (max-width:900px){
  .mo-performance__grid{grid-template-columns:repeat(2,1fr);}
  .mo-steps{grid-template-columns:1fr;gap:28px;}
}
</style>

{{!-- Projects section --}}
{{#get "posts" filter="tag:hash-project" include="tags" limit=@custom.max_project_count as |projects|}}
  {{#if projects}}
    <section class="container wrapper section projects">
      <h2 class="section__title">{{t "Latest work"}}</h2>
      {{#link href="/projects/" class="btn--view"}}
        <span class="m-r-sm">{{t "View all"}}</span> 
        {{> icon name="arrow-right" size="sm"}}
      {{/link}}

      <div class="grid project-feed" data-colors="{{@custom.project_card_color}}" data-layout="{{@custom.project_feed_layout}}" data-count="{{@custom.max_project_count}}">
        {{#foreach projects}}
          {{> project-card}}
        {{/foreach}}
      </div>
    </section>
  {{/if}}
{{/get}}


{{!-- Services - rendered if the /services/ page has the tag #home-services --}}
{{#get "pages" filter="tags:hash-home-services" include="tags" limit="1" as |services|}}
  {{#if services}}
    <section class="container wrapper section services m-b-lg">
      <h2 class="section__title w-100">{{#foreach services}}{{title}}{{/foreach}}</h2>
          
      {{#foreach services}}
        <ul class="grid grid-services">
          {{#foreach tags visibility="all"}}
            {{#match slug "!=" "hash-home-services"}}
              {{> service-card}}
            {{/match}}
          {{/foreach}}
        </ul>
      {{/foreach}}
    </section>
  {{/if}}
{{/get}}


{{!-- Clients section - rendered if the /clients/ page has the tag #home-clients --}}
{{#get "pages" filter="tags:hash-home-clients" include="tags" limit="1" as |clients|}}
  {{#if clients}}
    <section class="container wrapper section clients">
      {{#foreach clients}}
        <h2 class="section__title--mini w-100">{{title}}</h2>
        <ul class="client-logos w-100 m-b-lg">
          {{#foreach tags visibility="all"}}
            {{#if feature_image}}
              <li class="{{slug}}">
                <img class="lazyload" 
                    data-srcset="{{img_url feature_image size="xs"}} 100w,
                            {{img_url feature_image size="s"}} 300w"
                    srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                    data-sizes="auto"
                    data-src="{{img_url feature_image size="s"}}"
                    src="{{img_url feature_image size="xxs"}}"
                    alt="{{name}}"/>
              </li>
            {{/if}}
          {{/foreach}}
        </ul>
      {{/foreach}}
    </section>
  {{/if}}
{{/get}}


{{!-- Testimonials - rendered if the /testimonials/ page has the tag #home-testimonials --}}
{{#get "pages" filter="tags:hash-home-testimonials" include="tags" limit="1" as |testimonials|}}
  {{#if testimonials}}
    <section class="container wrapper section testimonials flex m-b-lg">
      <h2 class="section__title flex-1">{{#foreach testimonials}}{{title}}{{/foreach}}</h2>
          
      {{#foreach testimonials}}
        <ul class="grid grid-testimonials">
          {{#foreach tags visibility="all" limit="5"}}
            {{#match slug "!=" "hash-home-testimonials"}}
              {{> testimonial-card}}
            {{/match}}
          {{/foreach}}
        </ul>
      {{/foreach}}
    </section>
  {{/if}}
{{/get}}


{{!-- Team/authors section - rendered if the /authors/ page has the tag #home-authors --}}
{{#get "pages" filter="tags:hash-home-authors" include="tags" limit="1" as |team|}}
  {{#foreach team}}
    <section class="container wrapper section authors">
      <h2 class="section__title">{{title}}</h2>
      {{#link href=(url) class="btn--view"}}
        <span class="m-r-sm">{{t "View all"}}</span> 
        {{> icon name="arrow-right" size="sm"}}
      {{/link}}


      {{#get "authors" include="count.posts" order="count.posts desc" limit="4"}}
        <div class="grid auto grid-authors m-b-lg">
          {{#foreach authors}}
            {{#if count.posts}}
              {{> author-card show_img=true}}
            {{/if}}
          {{/foreach}}
        </div>
      {{/get}}
    </section>
  {{/foreach}}
{{/get}}


{{!-- FAQ section - rendered if the /faq/ page has the tag #home-faq --}}
{{#get "pages" filter="tags:hash-home-faq" include="tags" limit="1" as |faq|}}
  {{#if faq}}
    <section class="container wrapper section faq">
      {{#foreach faq}}
        <h2 class="section__title w-100">{{title}}</h2>
        <div class="faq-content content m-b-lg">
          {{content}}
        </div>
      {{/foreach}}
    </section>
  {{/if}}
{{/get}}


{{!-- Blog section - rendered if the /blog/ page has the tag #home-blog --}}
{{#get "pages" filter="tags:hash-home-blog" include="tags" limit="1" as |blog|}}
  {{#foreach blog}}
    <section class="container wrapper section blog">
      <h2 class="section__title">{{title}}</h2>
      {{#link href=(url) class="btn--view"}}
        <span class="m-r-sm">{{t "View all"}}</span> 
        {{> icon name="arrow-right" size="sm"}}
      {{/link}}
      
      {{#get "posts" filter="tag:-hash-project" include="tags,authors" limit="3"}}
        {{#if posts}}
          <div class="grid post-feed auto m-b-lg">
            {{#foreach posts}}
              {{> post-card
                hide_img=true
              }}
            {{/foreach}}
          </div>
        {{/if}}
      {{/get}}
    </section>
  {{/foreach}}
{{/get}}


{{!-- Categories/tags section - rendered if the /tags/ page has the tag #home-tags --}}
{{#get "pages" filter="tags:hash-home-tags" include="tags" limit="1" as |categories|}}
  {{#foreach categories}}
    <section class="container wrapper section tags">
      <h2 class="section__title">{{title}}</h2>
      {{#link href=(url) class="btn--view"}}
        <span class="m-r-sm">{{t "View all"}}</span> 
        {{> icon name="arrow-right" size="sm"}}
      {{/link}}

      {{#get "tags" filter="visibility:public" include="count.posts" order="count.posts desc" limit="6"}}
        {{#if tags}}
          <div class="grid grid-tags m-b">
            {{#foreach tags}}
              {{> tag-card show_img=true}}
            {{/foreach}}
          </div>
        {{/if}}
      {{/get}}
    </section>
  {{/foreach}}
{{/get}}
