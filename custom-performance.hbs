{{!< default}}

<div class="container wrapper pt-page">

  <section class="pt-header">
    <span class="mo-performance__label">{{t "Verified Track Record"}}</span>
    <h1 class="section__title">{{t "Performance Tracker"}}</h1>
    <p class="mo-performance__text">{{t "Every Elliott Wave analysis we've published — logged, tracked, and reported publicly. Only analyses with a clear outcome count toward the hit rate."}}</p>
  </section>

  <div class="mo-performance__grid pt-stats">
    <div class="mo-stat">
      <span class="mo-stat__num mo-stat__num--accent">80%</span>
      <span class="mo-stat__label">{{t "Hit Rate"}}</span>
    </div>
    <div class="mo-stat">
      <span class="mo-stat__num">10</span>
      <span class="mo-stat__label">{{t "Counted Analyses"}}</span>
    </div>
    <div class="mo-stat">
      <span class="mo-stat__num mo-stat__num--hit">8</span>
      <span class="mo-stat__label">{{t "Confirmed Hits"}}</span>
    </div>
    <div class="mo-stat">
      <span class="mo-stat__num mo-stat__num--miss">2</span>
      <span class="mo-stat__label">{{t "Confirmed Misses"}}</span>
    </div>
  </div>

  <p class="pt-methodology">
    <strong>{{t "Methodology:"}}</strong>
    {{t "Only analyses where the target zone was clearly reached (Hit) or clearly missed (Miss) are included in the performance score. Analyses with a deleted or adjusted target zone are not counted toward the hit rate."}}
  </p>

  <div class="pt-filters">
    <button class="pt-filter active" data-filter="all">{{t "All"}} (52)</button>
    <button class="pt-filter" data-filter="counted">{{t "Counted"}} (10)</button>
