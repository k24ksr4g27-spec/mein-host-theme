<style>
.mo-performance__label{display:block;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--color-primary);margin-bottom:12px;}
.mo-performance__text{max-width:620px;color:var(--color-grey-light);font-size:15px;line-height:1.7;margin-top:12px;}
.mo-performance__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:32px 0;}
.mo-stat{background:var(--color-dark-acc);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:24px 16px;text-align:center;}
.mo-stat__num{display:block;font-size:36px;font-weight:800;color:var(--color-white);line-height:1;}
.mo-stat__num--accent{color:var(--color-primary);}
.mo-stat__num--hit{color:var(--color-success);}
.mo-stat__num--miss{color:var(--color-error);}
.mo-stat__label{display:block;margin-top:8px;font-size:11px;letter-spacing:0.5px;text-transform:uppercase;color:var(--color-grey-light);}
.pt-page { padding: 56px 0 88px; }
.pt-header { max-width: 620px; margin-bottom: 32px; }
.pt-stats { margin: 0 0 28px; }
.pt-methodology {
  font-size: 13px;
  color: var(--color-grey-light);
  line-height: 1.7;
  background: var(--color-dark-acc);
  border-left: 3px solid var(--color-primary);
  border-radius: 6px;
  padding: 14px 18px;
  margin-bottom: 32px;
}
.pt-methodology strong { color: var(--color-white); }
.pt-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
.pt-filter {
  font: inherit;
  cursor: pointer;
  padding: 7px 16px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.12);
  background: var(--color-dark-acc);
  color: var(--color-grey-light);
}
.pt-filter.active { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-black); }
.pt-table-wrap { overflow-x: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; }
.pt-table { width: 100%; border-collapse: collapse; font-size: 13px; white-space: nowrap; }
.pt-table th {
  text-align: left;
  padding: 12px 16px;
  font-size: 11px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--color-grey-light);
  border-bottom: 1px solid rgba(255,255,255,0.12);
}
.pt-table td { padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,0.06); color: var(--color-grey-light); }
.pt-table tr:hover td { background: rgba(255,255,255,0.02); }
.pt-num { color: var(--color-grey-light); opacity: 0.6; }
.pt-asset { font-weight: 600; color: var(--color-white); }
.pt-type { text-transform: capitalize; }
.pt-badge { display: inline-flex; align-items: center; padding: 3px 10px; font-size: 11px; font-weight: 700; border-radius: 4px; }
.pt-badge--hit { background: rgba(16,185,129,0.12); color: var(--color-success); }
.pt-badge--miss { background: rgba(244,63,94,0.12); color: var(--color-error); }
.pt-badge--pending { background: rgba(148,163,184,0.14); color: var(--color-grey-light); }
.pt-asof { text-align: right; font-size: 12px; color: var(--color-grey-light); margin-top: 14px; }
.pt-cta {
  margin-top: 48px;
  padding: 32px;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  background: var(--color-dark-acc);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}
.pt-cta__title { font-size: 17px; font-weight: 700; color: var(--color-white); margin-bottom: 6px; }
@media (max-width: 700px) {
  .mo-performance__grid.pt-stats { grid-template-columns: repeat(2,1fr); }
}
</style>

<script>
(function () {
  var buttons = document.querySelectorAll('.pt-filter');
  var rows = document.querySelectorAll('#pt-tbody tr');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      buttons.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var filter = btn.getAttribute('data-filter');
      rows.forEach(function (row) {
        var status = row.getAttribute('data-status');
        var show = filter === 'all'
          || (filter === 'counted' && (status === 'hit' || status === 'miss'))
          || filter === status;
        row.style.display = show ? '' : 'none';
      });
    });
  });
})();
</script>
